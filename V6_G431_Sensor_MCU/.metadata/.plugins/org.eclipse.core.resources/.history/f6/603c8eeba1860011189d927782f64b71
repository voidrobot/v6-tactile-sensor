/**
 * @file sensor_dxl_service.c
 * @brief Minimal Dynamixel Protocol 2.0 slave for sensor READ/Fast Bulk requests.
 *        Adapted for 02_V6S custom board: SN74LXC2T45DCUR direction pin (USART1_DIR, PF1).
 */

#include "sensor_dxl_service.h"
#include "sensor_service_i2c.h"
#include <string.h>

#if SENSOR_TRANSPORT_USE_DXL

extern UART_HandleTypeDef huart1;

#define DXL_HEADER_0        0xFFU
#define DXL_HEADER_1        0xFFU
#define DXL_HEADER_2        0xFDU
#define DXL_RESERVED        0x00U
#define DXL_INST_PING       0x01U
#define DXL_INST_READ       0x02U
#define DXL_INST_STATUS     0x55U
#define DXL_INST_FAST_BULK_READ 0x9AU
#define DXL_BROADCAST_ID    0xFEU
#define DXL_ERR_NONE        0x00U
#define DXL_ERR_CRC         0x03U
#define DXL_ERR_RANGE       0x04U
#define DXL_ERR_LENGTH      0x05U
#define DXL_ERR_ACCESS      0x07U

#define DXL_RX_BUF_LEN      64U
#define DXL_TX_BUF_LEN      64U
#define DXL_FAST_BULK_PARAM_LEN 5U
#define DXL_FAST_BULK_RESPONSE_DELAY_US 420U
#define SENSOR_DXL_DIR_RX_STATE GPIO_PIN_RESET
#define SENSOR_DXL_DIR_TX_STATE GPIO_PIN_SET
static uint8_t s_dxl_rx_buf[DXL_RX_BUF_LEN] __attribute__((aligned(32)));
static uint8_t s_dxl_tx_buf[DXL_TX_BUF_LEN] __attribute__((aligned(32)));
static uint8_t s_dxl_rx_armed;
static uint32_t s_dxl_retry_tick;

static uint16_t dxl_crc(const uint8_t *data, uint16_t len)
{
    uint16_t crc = 0U;

    for (uint16_t i = 0U; i < len; i++) {
        crc ^= (uint16_t)data[i] << 8;
        for (uint8_t bit = 0U; bit < 8U; bit++) {
            crc = (crc & 0x8000U) ? (uint16_t)((crc << 1) ^ 0x8005U)
                                  : (uint16_t)(crc << 1);
        }
    }
    return crc;
}

static void dxl_delay_us(uint32_t delay_us)
{
    if (delay_us == 0U) {
        return;
    }
    if ((CoreDebug->DEMCR & CoreDebug_DEMCR_TRCENA_Msk) == 0U) {
        CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    }
    if ((DWT->CTRL & DWT_CTRL_CYCCNTENA_Msk) == 0U) {
        DWT->CYCCNT = 0U;
        DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
    }
    uint32_t start = DWT->CYCCNT;
    uint32_t wait = (SystemCoreClock / 1000000U) * delay_us;
    while ((uint32_t)(DWT->CYCCNT - start) < wait) {
        __NOP();
    }
}

static void dxl_arm_rx(void)
{
    (void)HAL_UART_AbortReceive(&huart1);
    /* DIR LOW = bus-to-MCU RX through SN74LXC2T45DCUR. */
    HAL_GPIO_WritePin(USART1_DIR_GPIO_Port, USART1_DIR_Pin, SENSOR_DXL_DIR_RX_STATE);
    /* RX mode after each DXL response. */
    (void)HAL_HalfDuplex_EnableReceiver(&huart1);
    __HAL_UART_CLEAR_FLAG(&huart1, UART_CLEAR_OREF | UART_CLEAR_NEF |
                                  UART_CLEAR_FEF  | UART_CLEAR_PEF |
                                  UART_CLEAR_IDLEF);
    huart1.ErrorCode = HAL_UART_ERROR_NONE;
#if defined(__DCACHE_PRESENT) && (__DCACHE_PRESENT == 1U)
    SCB_InvalidateDCache_by_Addr((uint32_t *)s_dxl_rx_buf, DXL_RX_BUF_LEN);
#endif

    if (HAL_UARTEx_ReceiveToIdle_DMA(&huart1, s_dxl_rx_buf, DXL_RX_BUF_LEN) == HAL_OK) {
        if (huart1.hdmarx != NULL) {
            __HAL_DMA_DISABLE_IT(huart1.hdmarx, DMA_IT_HT);
        }
        s_dxl_rx_armed = 1U;
    } else {
        s_dxl_rx_armed = 0U;
        s_dxl_retry_tick = HAL_GetTick();
    }
}

static HAL_StatusTypeDef dxl_start_tx(uint16_t size)
{
    s_dxl_rx_armed = 0U;
    (void)HAL_UART_AbortReceive(&huart1);
    /* DIR HIGH = MCU-to-bus TX through SN74LXC2T45DCUR. */
    HAL_GPIO_WritePin(USART1_DIR_GPIO_Port, USART1_DIR_Pin, SENSOR_DXL_DIR_TX_STATE);
    /* TX mode only while driving the shared DXL line. */
    if (HAL_HalfDuplex_EnableTransmitter(&huart1) != HAL_OK) {
        HAL_GPIO_WritePin(USART1_DIR_GPIO_Port, USART1_DIR_Pin, SENSOR_DXL_DIR_RX_STATE); /* restore RX. */
        return HAL_ERROR;
    }
    return HAL_UART_Transmit_DMA(&huart1, s_dxl_tx_buf, size);
}

static uint8_t sensor_id_is_local(uint8_t id)
{
    return (id == SENSOR_DXL_ID_BASE) ? 1U : 0U; /* one DXL id per bus. */
}

static void build_sensor_table(uint8_t ch, uint8_t out[SENSOR_DXL_REG_DATA_LEN])
{
    const sensor_ch_t *s = &g_sensor[ch];
    int32_t pressure = s->pressure_raw;
    int16_t temp = s->temp_raw;
    uint16_t hpa = s->value_hpa;

    out[0] = (uint8_t)(pressure & 0xFF);
    out[1] = (uint8_t)((pressure >> 8) & 0xFF);
    out[2] = (uint8_t)((pressure >> 16) & 0xFF);
    out[3] = (uint8_t)((pressure >> 24) & 0xFF);
    out[4] = (uint8_t)(temp & 0xFF);
    out[5] = (uint8_t)((temp >> 8) & 0xFF);
    out[6] = (uint8_t)(hpa & 0xFF);
    out[7] = (uint8_t)((hpa >> 8) & 0xFF);
    out[8] = (s->data_valid != 0U) ? 0x00U : 0x01U;
    out[9] = (uint8_t)(s->sample_cnt & 0xFFU);
}

static void send_status(uint8_t id, uint8_t error, const uint8_t *params, uint16_t param_len)
{
    uint16_t length = (uint16_t)(param_len + 4U);
    uint16_t offset = 0U;
    uint16_t crc;

    HAL_GPIO_WritePin(USART1_DIR_GPIO_Port, USART1_DIR_Pin, SENSOR_DXL_DIR_TX_STATE);

    if ((uint16_t)(param_len + 11U) > DXL_TX_BUF_LEN) {
        return;
    }

    s_dxl_tx_buf[offset++] = DXL_HEADER_0;
    s_dxl_tx_buf[offset++] = DXL_HEADER_1;
    s_dxl_tx_buf[offset++] = DXL_HEADER_2;
    s_dxl_tx_buf[offset++] = DXL_RESERVED;
    s_dxl_tx_buf[offset++] = id;
    s_dxl_tx_buf[offset++] = (uint8_t)(length & 0xFFU);
    s_dxl_tx_buf[offset++] = (uint8_t)((length >> 8) & 0xFFU);
    s_dxl_tx_buf[offset++] = DXL_INST_STATUS;
    s_dxl_tx_buf[offset++] = error;
    if ((params != NULL) && (param_len > 0U)) {
        memcpy(&s_dxl_tx_buf[offset], params, param_len);
        offset = (uint16_t)(offset + param_len);
    }
    crc = dxl_crc(s_dxl_tx_buf, offset);
    s_dxl_tx_buf[offset++] = (uint8_t)(crc & 0xFFU);
    s_dxl_tx_buf[offset++] = (uint8_t)((crc >> 8) & 0xFFU);

#if defined(__DCACHE_PRESENT) && (__DCACHE_PRESENT == 1U)
    SCB_CleanDCache_by_Addr((uint32_t *)s_dxl_tx_buf, DXL_TX_BUF_LEN);
#endif
    g_sensor_uart_busy = 1U;
    if (dxl_start_tx(offset) != HAL_OK) {
        g_sensor_uart_busy = 0U;
        g_sen1_drop_count++;
        dxl_arm_rx();
    }
}

static void build_sensor_bank(uint8_t out[SENSOR_DXL_REG_TOTAL_LEN])
{
    for (uint8_t ch = 0U; ch < SENSOR_CH_NUM; ch++) {
        build_sensor_table(ch, &out[ch * SENSOR_DXL_REG_DATA_LEN]);
    }
}

static void handle_read(uint8_t id, const uint8_t *params, uint16_t param_len)
{
    uint8_t table[SENSOR_DXL_REG_TOTAL_LEN];
    uint16_t addr;
    uint16_t len;
    uint16_t rel;

    if (param_len < 4U) {
        send_status(id, DXL_ERR_LENGTH, NULL, 0U);
        return;
    }

    addr = (uint16_t)params[0] | ((uint16_t)params[1] << 8);
    len  = (uint16_t)params[2] | ((uint16_t)params[3] << 8);
    if ((addr < SENSOR_DXL_REG_DATA_BASE) ||
        (addr >= (SENSOR_DXL_REG_DATA_BASE + SENSOR_DXL_REG_TOTAL_LEN))) {
        send_status(id, DXL_ERR_RANGE, NULL, 0U);
        return;
    }

    rel = (uint16_t)(addr - SENSOR_DXL_REG_DATA_BASE);
    if ((len == 0U) || ((rel + len) > SENSOR_DXL_REG_TOTAL_LEN)) {
        send_status(id, DXL_ERR_LENGTH, NULL, 0U);
        return;
    }

    build_sensor_bank(table);
    send_status(id, DXL_ERR_NONE, &table[rel], len);
}

static void send_fast_bulk_status_block(uint8_t error, const uint8_t *params, uint16_t param_len)
{
    uint16_t offset = 0U;
    uint16_t crc;

    if ((uint16_t)(param_len + 4U) > DXL_TX_BUF_LEN) {
        return;
    }

    s_dxl_tx_buf[offset++] = error;
    s_dxl_tx_buf[offset++] = SENSOR_DXL_ID_BASE;
    if ((params != NULL) && (param_len > 0U)) {
        memcpy(&s_dxl_tx_buf[offset], params, param_len);
        offset = (uint16_t)(offset + param_len);
    }
    crc = dxl_crc(s_dxl_tx_buf, offset);
    s_dxl_tx_buf[offset++] = (uint8_t)(crc & 0xFFU);
    s_dxl_tx_buf[offset++] = (uint8_t)((crc >> 8) & 0xFFU);

#if defined(__DCACHE_PRESENT) && (__DCACHE_PRESENT == 1U)
    SCB_CleanDCache_by_Addr((uint32_t *)s_dxl_tx_buf, DXL_TX_BUF_LEN);
#endif
    dxl_delay_us(DXL_FAST_BULK_RESPONSE_DELAY_US);
    g_sensor_uart_busy = 1U;
    if (dxl_start_tx(offset) != HAL_OK) {
        g_sensor_uart_busy = 0U;
        g_sen1_drop_count++;
        dxl_arm_rx();
    }
}

static void handle_fast_bulk_read(const uint8_t *params, uint16_t param_len)
{
    uint8_t table[SENSOR_DXL_REG_TOTAL_LEN];

    for (uint16_t off = 0U; (uint16_t)(off + DXL_FAST_BULK_PARAM_LEN) <= param_len; off = (uint16_t)(off + DXL_FAST_BULK_PARAM_LEN)) {
        uint8_t id = params[off];
        uint16_t addr = (uint16_t)params[off + 1U] | ((uint16_t)params[off + 2U] << 8);
        uint16_t len = (uint16_t)params[off + 3U] | ((uint16_t)params[off + 4U] << 8);
        uint16_t rel;

        if (id != SENSOR_DXL_ID_BASE) {
            continue;
        }
        if ((addr < SENSOR_DXL_REG_DATA_BASE) ||
            (addr >= (SENSOR_DXL_REG_DATA_BASE + SENSOR_DXL_REG_TOTAL_LEN))) {
            send_fast_bulk_status_block(DXL_ERR_RANGE, NULL, 0U);
            return;
        }
        rel = (uint16_t)(addr - SENSOR_DXL_REG_DATA_BASE);
        if ((len == 0U) || ((rel + len) > SENSOR_DXL_REG_TOTAL_LEN)) {
            send_fast_bulk_status_block(DXL_ERR_LENGTH, NULL, 0U);
            return;
        }

        build_sensor_bank(table);
        send_fast_bulk_status_block(DXL_ERR_NONE, &table[rel], len);
        return;
    }
}

static uint8_t handle_packet_at(const uint8_t *buf, uint16_t size)
{
    uint16_t length;
    uint16_t total;
    uint16_t crc_rx;
    uint16_t crc_calc;
    uint8_t id;
    uint8_t inst;
    const uint8_t *params;
    uint16_t param_len;

    if (size < 10U) {
        return 0U;
    }
    if ((buf[0] != DXL_HEADER_0) || (buf[1] != DXL_HEADER_1) ||
        (buf[2] != DXL_HEADER_2) || (buf[3] != DXL_RESERVED)) {
        return 0U;
    }

    id = buf[4];
    length = (uint16_t)buf[5] | ((uint16_t)buf[6] << 8);
    total = (uint16_t)(length + 7U);
    if ((length < 3U) || (total < 10U) || (total > size)) { /* total<10: uint16 overflow guard (length??xFFF9 wraps). */
        g_sen1_drop_count++;
        return 1U;
    }

    crc_rx = (uint16_t)buf[total - 2U] | ((uint16_t)buf[total - 1U] << 8);
    crc_calc = dxl_crc(buf, (uint16_t)(total - 2U));
    if (crc_rx != crc_calc) {
        send_status(id, DXL_ERR_CRC, NULL, 0U);
        return 1U;
    }

    g_sen1_req_count++;
    inst = buf[7];
    params = &buf[8];
    param_len = (uint16_t)(length - 3U);
    if ((id == DXL_BROADCAST_ID) && (inst == DXL_INST_FAST_BULK_READ)) {
        handle_fast_bulk_read(params, param_len);
        return 1U;
    }

    if (sensor_id_is_local(id) == 0U) {
        g_sen1_other_count++;
        g_sen1_other_id_count++; /* motor frame. */
        return 1U;
    }

    if (inst == DXL_INST_PING) {
        const uint8_t model[3] = {0x02U, 0x06U, 0x01U}; /* 02_V6S board ID. */
        send_status(id, DXL_ERR_NONE, model, sizeof(model));
    } else if (inst == DXL_INST_READ) {
        handle_read(id, params, param_len);
    } else {
        send_status(id, DXL_ERR_ACCESS, NULL, 0U);
    }
    return 1U;
}

static void handle_packet(const uint8_t *buf, uint16_t size)
{
    uint8_t found = 0U;

    if (size < 10U) {
        return;
    }

    for (uint16_t i = 0U; (i + 10U) <= size; i++) {
        if ((buf[i] == DXL_HEADER_0) && (buf[i + 1U] == DXL_HEADER_1) &&
            (buf[i + 2U] == DXL_HEADER_2) && (buf[i + 3U] == DXL_RESERVED)) {
            found = 1U;
            if ((sensor_id_is_local(buf[i + 4U]) == 0U) && (buf[i + 4U] != DXL_BROADCAST_ID)) {
                g_sen1_other_count++;
                g_sen1_other_id_count++; /* motor frame. */
                continue; /* skip motor frame. */
            }
            if (handle_packet_at(&buf[i], (uint16_t)(size - i)) != 0U) {
                return;
            }
        }
    }

    if (found == 0U) {
        g_sen1_other_count++; /* unaligned noise/chunk. */
        g_sen1_noise_count++; /* unaligned chunk. */
    }
}

void sensor_dxl_service_init(void)
{
    s_dxl_rx_armed = 0U;
    s_dxl_retry_tick = 0U;
    memset(s_dxl_rx_buf, 0, sizeof(s_dxl_rx_buf));
    memset(s_dxl_tx_buf, 0, sizeof(s_dxl_tx_buf));
    dxl_arm_rx();
}

void sensor_dxl_service_poll(void)
{
    if (g_sensor_uart_busy != 0U) {
        return;
    }

    if ((s_dxl_rx_armed != 0U) && (huart1.hdmarx != NULL) &&
        (__HAL_DMA_GET_COUNTER(huart1.hdmarx) == 0U)) {
        s_dxl_rx_armed = 0U; /* full DMA no callback guard. */
        s_dxl_retry_tick = HAL_GetTick();
    }

    if ((s_dxl_rx_armed != 0U) && (huart1.RxState != HAL_UART_STATE_BUSY_RX)) {
        s_dxl_rx_armed = 0U; /* HAL state guard. */
        s_dxl_retry_tick = HAL_GetTick();
    }

    if ((s_dxl_rx_armed == 0U) &&
        ((uint32_t)(HAL_GetTick() - s_dxl_retry_tick) >= 1U)) {
        /* Retry RX arm after transient UART/DMA state. */
        dxl_arm_rx();
    }
}

void sensor_dxl_uart_rx_event(UART_HandleTypeDef *huart, uint16_t size)
{
    if (huart->Instance != USART1) {
        return;
    }

    s_dxl_rx_armed = 0U;
#if defined(__DCACHE_PRESENT) && (__DCACHE_PRESENT == 1U)
    SCB_InvalidateDCache_by_Addr((uint32_t *)s_dxl_rx_buf, DXL_RX_BUF_LEN);
#endif
    handle_packet(s_dxl_rx_buf, size);
    if (g_sensor_uart_busy == 0U) {
        dxl_arm_rx(); /* immediate re-arm in ISR; poll is fallback only. */
    }
}

void sensor_dxl_uart_tx_complete(UART_HandleTypeDef *huart)
{
    if (huart->Instance != USART1) {
        return;
    }

    /* DMA TC fires when last byte enters TDR, not when shift-register finishes.
     * Wait for TC so the bus is fully idle before switching to RX. */
    uint32_t t0 = HAL_GetTick();
    while ((huart->Instance->ISR & USART_ISR_TC) == 0U) {
        if ((HAL_GetTick() - t0) >= 2U) { break; } /* 2 ms guard. */
    }

    g_sensor_uart_busy = 0U;
    g_sen1_rsp_count++;
    s_dxl_rx_armed = 0U;
    dxl_arm_rx(); /* re-arm RX after TC confirmed. */
}

void sensor_dxl_uart_error(UART_HandleTypeDef *huart)
{
    if (huart->Instance != USART1) {
        return;
    }

    __HAL_UART_CLEAR_OREFLAG(huart);
    __HAL_UART_CLEAR_FEFLAG(huart);
    __HAL_UART_CLEAR_NEFLAG(huart);
    g_sensor_uart_busy = 0U;
    g_sen1_drop_count++;
    s_dxl_rx_armed = 0U;
    s_dxl_retry_tick = HAL_GetTick();

}

void dbg_cmd_arx(void)
{
	if(s_dxl_rx_armed == 0U)
		dxl_arm_rx();
}

void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    sensor_dxl_uart_rx_event(huart, Size);
}

#else

void sensor_dxl_service_init(void) {}
void sensor_dxl_service_poll(void) {}
void sensor_dxl_uart_rx_event(UART_HandleTypeDef *huart, uint16_t size)
{
    (void)huart;
    (void)size;
}
void sensor_dxl_uart_tx_complete(UART_HandleTypeDef *huart)
{
    (void)huart;
}
void sensor_dxl_uart_error(UART_HandleTypeDef *huart)
{
    (void)huart;
}

