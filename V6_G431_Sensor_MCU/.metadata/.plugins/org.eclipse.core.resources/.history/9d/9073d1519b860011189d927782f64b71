static char cmd_line_argv[MAX_CMD_ARGV][MAX_ARGV_LENGTH];
static int cmd_line_argc;
static char command_history[COMMAND_HISTORY_MAX][COMMAND_MAX_LENGTH];
static uint8_t history_wr;
static uint8_t history_rd;
static uint8_t esc_step[TPID_MAX];

static void parse_argv(const char *cmd)
{
    cmd_line_argc = 0;
    memset(cmd_line_argv, 0, sizeof(cmd_line_argv));

    const char *p = cmd;
    while ((*p != '\0') && (cmd_line_argc < MAX_CMD_ARGV)) {
        while (*p == ' ') { p++; }
        if (*p == '\0') { break; }

        int len = 0;
        while ((*p != '\0') && (*p != ' ') && (len < (MAX_ARGV_LENGTH - 1))) {
            cmd_line_argv[cmd_line_argc][len++] = *p++;
        }
        cmd_line_argv[cmd_line_argc][len] = '\0';
        cmd_line_argc++;
    }
}

static void erase_current_line(TERM_PORT tpid)
{
    int len = cmd_index[tpid];
    for (int i = 0; i < len; i++) { term_printf(tpid, "\b"); }
    for (int i = 0; i < len; i++) { term_printf(tpid, " "); }
    for (int i = 0; i < len; i++) { term_printf(tpid, "\b"); }
}

static void save_history(const char *cmd)
{
    if ((cmd == NULL) || (cmd[0] == '\0')) {
        return;
    }

    uint8_t prev = (history_wr == 0U) ? (COMMAND_HISTORY_MAX - 1U) : (uint8_t)(history_wr - 1U);
    if (strcmp(command_history[prev], cmd) == 0) {
        return;
    }

    strncpy(command_history[history_wr], cmd, COMMAND_MAX_LENGTH - 1);
    command_history[history_wr][COMMAND_MAX_LENGTH - 1] = '\0';
    history_wr = (uint8_t)((history_wr + 1U) % COMMAND_HISTORY_MAX);
}

static const char *history_get(uint8_t direction)
{
    if (direction == ARROW_UP) {
        uint8_t next = (history_rd == 0U) ? (COMMAND_HISTORY_MAX - 1U) : (uint8_t)(history_rd - 1U);
        if (command_history[next][0] != '\0') {
            history_rd = next;
            return command_history[history_rd];
        }
    } else if (direction == ARROW_DOWN) {
        if (history_rd != history_wr) {
            history_rd = (uint8_t)((history_rd + 1U) % COMMAND_HISTORY_MAX);
            if (history_rd != history_wr) {
                return command_history[history_rd];
            }
        }
    }
    return NULL;
}

static void recall_history(TERM_PORT tpid, uint8_t direction)
{
    const char *hist = history_get(direction);

    erase_current_line(tpid);
    command[tpid][0] = '\0';
    cmd_index[tpid] = 0;

    if ((hist != NULL) && (hist[0] != '\0')) {
        strncpy(command[tpid], hist, COMMAND_MAX_LENGTH - 1);
        command[tpid][COMMAND_MAX_LENGTH - 1] = '\0';
        cmd_index[tpid] = (int)strlen(command[tpid]);
        term_printf(tpid, "%s", command[tpid]);
    }
}

static uint8_t arrow_key_process(TERM_PORT tpid, char ch)
{
    if (esc_step[tpid] == 1U) {
        if (ch == '[') {
            esc_step[tpid] = 2U;
            return 1U;
        }
        esc_step[tpid] = 0U;
        return 0U;
    }

    if (esc_step[tpid] == 2U) {
        esc_step[tpid] = 0U;
        if (ch == 'A') {
            recall_history(tpid, ARROW_UP);
        } else if (ch == 'B') {
            recall_history(tpid, ARROW_DOWN);
        }
        return 1U;
    }

    return 0U;
}

