static void cmd_led(TERM_PORT tpid)
{
    if (cmd_line_argc >= 2) {
        if (strcmp(cmd_line_argv[1], "TEST") == 0) {
            if (cmd_line_argc >= 3) {
                uint8_t on = (strcmp(cmd_line_argv[2], "ON") == 0) ? 1U : 0U;
                ws2812_set_test(on);
                term_printf(tpid, "led test=%s\r\n", on ? "ON" : "OFF");
            } else {
                term_printf(tpid, "LED TEST ON|OFF\r\n");
            }
            return;
        }
        if (cmd_line_argc >= 4) {
            uint8_t r = (uint8_t)strtoul(cmd_line_argv[1], NULL, 0);
            uint8_t g = (uint8_t)strtoul(cmd_line_argv[2], NULL, 0);
            uint8_t b = (uint8_t)strtoul(cmd_line_argv[3], NULL, 0);
            ws2812_set_test(0U);
            ws2812_set_rgb(r, g, b);
            term_printf(tpid, "led=%u,%u,%u\r\n", (unsigned int)r, (unsigned int)g, (unsigned int)b);
            return;
        }
    }
    term_printf(tpid, "LED <r> <g> <b>  |  LED TEST ON|OFF\r\n");
}

