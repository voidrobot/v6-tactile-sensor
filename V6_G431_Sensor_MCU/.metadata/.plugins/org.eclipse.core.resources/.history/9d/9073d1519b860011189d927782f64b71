static void print_i2c_status(TERM_PORT tpid)
{
    for (uint8_t ch = 0U; ch < SENSOR_CH_NUM; ch++) {
        term_printf(tpid,
                    "\r\n[I2C%u] present=%u data_err=%u st=%u p=%u raw=%ld temp=%d.%02dC sample=%lu start=%lu err=%lu i2cerr=0x%08lX\r\n",
                    (unsigned int)(ch + 1U),
                    (unsigned int)g_sensor[ch].present,
                    (unsigned int)((g_sensor[ch].data_valid != 0U) ? 0U : 1U),
                    (unsigned int)g_sensor[ch].state,
                    (unsigned int)g_sensor[ch].value_hpa,
                    (long)g_sensor[ch].pressure_raw,
                    (int)(g_sensor[ch].temp_c_x100 / 100),
                    (int)abs(g_sensor[ch].temp_c_x100 % 100),
                    (unsigned long)g_sensor[ch].sample_cnt,
                    (unsigned long)g_sensor[ch].start_cnt,
                    (unsigned long)g_sensor[ch].err_cnt,
                    (unsigned long)g_sensor[ch].last_i2c_err);
    }
}

static void cmd_i2c_test(TERM_PORT tpid, uint8_t ch)
{
    uint8_t buf[5] = {0};
    HAL_StatusTypeDef ret = sensor_service_i2c_test(ch, buf);
    if (ret == HAL_OK) {
        uint32_t praw = ((uint32_t)buf[2] << 16) | ((uint32_t)buf[1] << 8) | buf[0];
        int16_t traw = (int16_t)(((uint16_t)buf[4] << 8) | buf[3]);
        term_printf(tpid, "\r\n[I2C test ch%u] rawP=0x%06lX rawT=%d\r\n",
                    (unsigned int)ch, (unsigned long)praw, (int)traw);
    } else {
        term_printf(tpid, "\r\n[I2C test ch%u] fail ret=%u err=0x%08lX\r\n",
                    (unsigned int)ch, (unsigned int)ret,
                    (unsigned long)g_sensor[ch].last_i2c_err);
    }
}

static void cmd_i2c_scan(TERM_PORT tpid, uint8_t ch)
{
    uint8_t result[16] = {0};
    uint8_t found = sensor_service_i2c_scan(ch, result);
    term_printf(tpid, "\r\n[I2C scan ch%u] found=%u\r\n", (unsigned int)ch, (unsigned int)found);
    for (uint8_t i = 0U; (i < found) && (i < 16U); i++) {
        term_printf(tpid, "  0x%02X\r\n", (unsigned int)result[i]);
    }
}

static void cmd_i2c(TERM_PORT tpid)
{
    if ((cmd_line_argc >= 3) && (strcmp(cmd_line_argv[1], "TEST") == 0)) {
        uint8_t ch = (uint8_t)atoi(cmd_line_argv[2]);
        if (ch < SENSOR_CH_NUM) {
            cmd_i2c_test(tpid, ch);
        } else {
            term_printf(tpid, "channel must be 0..%u\r\n", (unsigned int)(SENSOR_CH_NUM - 1U));
        }
    } else if ((cmd_line_argc >= 3) && (strcmp(cmd_line_argv[1], "SCAN") == 0)) {
        uint8_t ch = (uint8_t)atoi(cmd_line_argv[2]);
        if (ch < SENSOR_CH_NUM) {
            cmd_i2c_scan(tpid, ch);
        } else {
            term_printf(tpid, "channel must be 0..%u\r\n", (unsigned int)(SENSOR_CH_NUM - 1U));
        }
    } else if ((cmd_line_argc >= 4) && (strcmp(cmd_line_argv[1], "FAKE") == 0)) {
        uint8_t ch = (uint8_t)atoi(cmd_line_argv[2]);
        uint8_t on = (strcmp(cmd_line_argv[3], "ON") == 0) ? 1U : 0U;
        if (ch < SENSOR_CH_NUM) {
            g_sensor[ch].use_fake = on;
            if (on) {
                g_sensor[ch].present = 1U;
                g_sensor[ch].state   = SS_IDLE;
            }
            term_printf(tpid, "I2C FAKE ch%u=%s\r\n", (unsigned int)ch, on ? "ON" : "OFF");
        } else {
            term_printf(tpid, "channel must be 0..%u\r\n", (unsigned int)(SENSOR_CH_NUM - 1U));
        }
    } else {
        print_i2c_status(tpid);
    }
}

