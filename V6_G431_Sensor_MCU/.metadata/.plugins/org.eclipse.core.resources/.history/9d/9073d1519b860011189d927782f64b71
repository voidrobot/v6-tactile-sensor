static void command_process(TERM_PORT tpid)
{
    command[tpid][cmd_index[tpid]] = '\0';
    parse_argv(command[tpid]);

    if (cmd_line_argc > 0) {
        save_history(command[tpid]);
        history_rd = history_wr;

        for (int i = 0; i < MAX_LONG_COMMANDS; i++) {
            if (strcmp(LongCommandsSet[i].cmd, END_OF_LONG_COMMANDS) == 0) {
                LongCommandsSet[i].func(tpid);
                break;
            }
            if (strcmp(cmd_line_argv[0], LongCommandsSet[i].cmd) == 0) {
                LongCommandsSet[i].func(tpid);
                break;
            }
        }
    }

    memset(command[tpid], 0, COMMAND_MAX_LENGTH);
    cmd_index[tpid] = 0;
}

static void debug_command_process(TERM_PORT tpid, char ch)
{
    if ((ch == '\n') && (cmd_index[tpid] == 0)) {
        return;
    }

    if (ch == 0x1B) {
        esc_step[tpid] = 1U;
        return;
    }

    if (esc_step[tpid] != 0U) {
        (void)arrow_key_process(tpid, ch);
        return;
    }

    if ((ch == '\r') || (ch == '\n')) {
        term_printf(tpid, "\r\n");
        command_process(tpid);
    } else if (((ch == '\b') || (ch == 0x7F)) && (cmd_index[tpid] > 0)) {
        cmd_index[tpid]--;
        command[tpid][cmd_index[tpid]] = '\0';
        if (echo_mode != 0) { term_printf(tpid, "\b \b"); }
    } else if ((cmd_index[tpid] < (COMMAND_MAX_LENGTH - 1)) && (ch >= 0x20) && (ch < 0x7F)) {
        char uc = (char)toupper((unsigned char)ch);
        command[tpid][cmd_index[tpid]++] = uc;
        command[tpid][cmd_index[tpid]] = '\0';
        if (echo_mode != 0) { send_to_uart_tx_queue(tpid, uc); }
    }
}

void debug_feature_service(TERM_PORT tpid)
{
    char ch;
    while ((ch = receive_from_uart_rx_queue(tpid)) != (char)RX_BUFFER_EMPTY) {
        debug_command_process(tpid, ch);
    }
}

void init_debug_history(void)
{
    memset(command_history, 0, sizeof(command_history));
    history_wr = 0U;
    history_rd = 0U;
    memset(esc_step, 0, sizeof(esc_step));
}
