    term_printf(tpid, " PARM SAVE        : save working params to flash (page 7, 0x08003800)\r\n");
    term_printf(tpid, " PARM LOAD        : load params from flash\r\n");
    term_printf(tpid, " PARM DEFAULT     : reset params to defaults (RAM only)\r\n");
    term_printf(tpid, " PARM ERASE       : erase flash param page\r\n");
