static void cmd_mon(TERM_PORT tpid)
{
    if (cmd_line_argc < 2) {
        term_printf(tpid, "\r\nMON ON/OFF | MON INT <sec> | MON MODE <mask> | MON ST\r\n");
        term_printf(tpid, "on=%lu int=%lu mode=0x%02lX\r\n",
                    (unsigned long)g_mon_onoff,
                    (unsigned long)env_working[PARM_MON_INTERVAL_SEC],
                    (unsigned long)g_mon_flag);
        return;
    }

    if (strcmp(cmd_line_argv[1], "ON") == 0) {
        env_working[PARM_MON_ONOFF] = 1U;
        g_mon_onoff = 1U;
    } else if (strcmp(cmd_line_argv[1], "OFF") == 0) {
        env_working[PARM_MON_ONOFF] = 0U;
        g_mon_onoff = 0U;
    } else if ((strcmp(cmd_line_argv[1], "INT") == 0) && (cmd_line_argc >= 3)) {
        env_working[PARM_MON_INTERVAL_SEC] = (uint32_t)strtoul(cmd_line_argv[2], NULL, 0);
        if (env_working[PARM_MON_INTERVAL_SEC] == 0U) { env_working[PARM_MON_INTERVAL_SEC] = 1U; }
    } else if ((strcmp(cmd_line_argv[1], "MODE") == 0) && (cmd_line_argc >= 3)) {
        env_working[PARM_MON_FLAG] = (uint32_t)strtoul(cmd_line_argv[2], NULL, 0);
        g_mon_flag = env_working[PARM_MON_FLAG];
    } else if (strcmp(cmd_line_argv[1], "ST") == 0) {
        uint32_t save = env_working[PARM_MON_ONOFF];
        env_working[PARM_MON_ONOFF] = 1U;
        monitor_service(tpid);
        env_working[PARM_MON_ONOFF] = save;
    }

    term_printf(tpid, "\r\nmonitor on=%lu int=%lu mode=0x%02lX\r\n",
                (unsigned long)env_working[PARM_MON_ONOFF],
                (unsigned long)env_working[PARM_MON_INTERVAL_SEC],
                (unsigned long)env_working[PARM_MON_FLAG]);
}

