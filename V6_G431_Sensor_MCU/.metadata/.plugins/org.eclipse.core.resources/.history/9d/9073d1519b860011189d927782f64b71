static void cmd_parm(TERM_PORT tpid)
{
    if (cmd_line_argc < 2) {
        term_printf(tpid, "PARM SAVE|LOAD|DEFAULT|SHOW\r\n");
        return;
    }

    if (strcmp(cmd_line_argv[1], "SAVE") == 0) {
        env_flash_copy_to_flash_buf();
        HAL_StatusTypeDef st = env_flash_save();
        term_printf(tpid, "PARM SAVE %s\r\n", (st == HAL_OK) ? "OK" : "FAIL");

    } else if (strcmp(cmd_line_argv[1], "LOAD") == 0) {
        env_flash_default();
        env_flash_load();
        env_flash_copy_to_working();
        term_printf(tpid, "PARM LOAD OK\r\n");

    } else if (strcmp(cmd_line_argv[1], "DEFAULT") == 0) {
        env_flash_default();
        env_flash_copy_to_working();
        term_printf(tpid, "PARM DEFAULT (RAM only - use PARM SAVE to persist)\r\n");

    } else if (strcmp(cmd_line_argv[1], "ERASE") == 0) {
        HAL_StatusTypeDef st = env_flash_erase();
        term_printf(tpid, "PARM ERASE %s\r\n", (st == HAL_OK) ? "OK" : "FAIL");

    } else if (strcmp(cmd_line_argv[1], "SHOW") == 0) {
        term_printf(tpid, "\r\n[PARM] working values:\r\n");
        term_printf(tpid, "  [%u] TRACE_FLAG       = %lu\r\n",
                    PARM_TRACE_FLAG, (unsigned long)env_working[PARM_TRACE_FLAG]);
        term_printf(tpid, "  [%u] MON_ONOFF        = %lu\r\n",
                    PARM_MON_ONOFF, (unsigned long)env_working[PARM_MON_ONOFF]);
        term_printf(tpid, "  [%u] MON_INTERVAL_SEC = %lu\r\n",
                    PARM_MON_INTERVAL_SEC, (unsigned long)env_working[PARM_MON_INTERVAL_SEC]);
        term_printf(tpid, "  [%u] MON_FLAG         = 0x%02lX\r\n",
                    PARM_MON_FLAG, (unsigned long)env_working[PARM_MON_FLAG]);
        term_printf(tpid, "  [%u] MON_LINE         = %lu\r\n",
                    PARM_MON_LINE, (unsigned long)env_working[PARM_MON_LINE]);
        term_printf(tpid, "  [%u] I2C_POLL_MS      = %lu\r\n",
                    PARM_I2C_POLL_MS, (unsigned long)env_working[PARM_I2C_POLL_MS]);
        term_printf(tpid, "  [%u] UART_DEBUG_ECHO  = %lu\r\n",
                    PARM_UART_DEBUG_ECHO, (unsigned long)env_working[PARM_UART_DEBUG_ECHO]);
    } else {
        term_printf(tpid, "PARM SAVE|LOAD|DEFAULT|ERASE|SHOW\r\n");
    }
}

